# =====================================================
# SCADA PLATFORM -- ENVIRONMENT CONFIGURATION
# =====================================================
# Copy this file to .env and customize as needed
# Most defaults work out of the box for single-machine deployment


# =====================================================
# DATABASE CONFIGURATION
# =====================================================
POSTGRES_USER=scada_admin
POSTGRES_PASSWORD=scada_secure_2024
POSTGRES_DB=scada_platform
DATABASE_URL=postgresql://scada_admin:scada_secure_2024@timescaledb:5432/scada_platform

# External access (if connecting from outside Docker network)
DATABASE_HOST=localhost
DATABASE_PORT=5432


# =====================================================
# REDIS CONFIGURATION
# =====================================================
REDIS_HOST=redis
REDIS_PORT=6379


# =====================================================
# ADMIN SERVICE CONFIGURATION
# =====================================================
ADMIN_REST_PORT=9000
ADMIN_WS_PORT=9001
ADMIN_DASHBOARD_PORT=3000

# JWT Secret for admin authentication (change in production!)
JWT_SECRET=your-secret-key-change-in-production-now


# =====================================================
# NODE CONFIGURATION
# =====================================================

# Auto-connect to master (skip startup dialog)
# Set to 'true' for Docker, 'false' for interactive deployment
AUTO_CONNECT=true

# Master (Admin) IP address
# Use 'admin_service' inside Docker network
# Use actual IP (e.g., 192.168.1.100) for cross-machine deployment
MASTER_IP=admin_service
MASTER_PORT=9000


# =====================================================
# NODE SERVICE PORTS
# =====================================================

# GEN-001 (Generation Station 1)
GEN001_REST_PORT=8101
GEN001_WS_PORT=8102
GEN001_MODBUS_PORT=5020

# GEN-002 (Generation Station 2)
GEN002_REST_PORT=8103
GEN002_WS_PORT=8104
GEN002_MODBUS_PORT=5021

# SUB-001 (Transmission Substation 1)
SUB001_REST_PORT=8111
SUB001_WS_PORT=8112
SUB001_MODBUS_PORT=5030

# SUB-002 (Transmission Substation 2)
SUB002_REST_PORT=8113
SUB002_WS_PORT=8114
SUB002_MODBUS_PORT=5031

# SUB-003 (Transmission Substation 3)
SUB003_REST_PORT=8115
SUB003_WS_PORT=8116
SUB003_MODBUS_PORT=5032

# DIST-001 (Distribution Station 1)
DIST001_REST_PORT=8131
DIST001_WS_PORT=8132
DIST001_MODBUS_PORT=5040

# DIST-002 (Distribution Station 2)
DIST002_REST_PORT=8133
DIST002_WS_PORT=8134
DIST002_MODBUS_PORT=5041


# =====================================================
# MONITORING CONFIGURATION
# =====================================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# Grafana admin credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123


# =====================================================
# SIMULATION PARAMETERS
# =====================================================

# Simulation speed multiplier (1.0 = real-time)
SIM_SPEED=1.0

# Telemetry broadcast interval (seconds)
TELEMETRY_INTERVAL=1.0

# Registration heartbeat interval (seconds)
HEARTBEAT_INTERVAL=10.0


# =====================================================
# SECURITY SETTINGS
# =====================================================

# JWT token expiration (hours)
JWT_EXPIRATION_HOURS=8

# Maximum login attempts before lockout
MAX_LOGIN_ATTEMPTS=5

# Session timeout (minutes)
SESSION_TIMEOUT=30


# =====================================================
# LOGGING CONFIGURATION
# =====================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format: json or text
LOG_FORMAT=text

# Enable Modbus transaction logging to database
LOG_MODBUS_TRANSACTIONS=true

# Enable API access logging
LOG_API_ACCESS=true


# =====================================================
# CROSS-MACHINE DEPLOYMENT
# =====================================================

# For deploying nodes on separate machines:
# 1. On admin machine:
#    - Keep AUTO_CONNECT=true
#    - Note the admin machine's IP (use: hostname -I)
#
# 2. On node machine:
#    - Set AUTO_CONNECT=false (for startup dialog)
#    - OR set AUTO_CONNECT=true and MASTER_IP=<admin-ip>
#    - Run: ./launch_node.sh SUB-001

# Example for node on remote machine:
# AUTO_CONNECT=true
# MASTER_IP=192.168.1.100
# MASTER_PORT=9000
